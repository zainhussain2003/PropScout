{
  "version": 2,
  "defaultBuilder": "codex",
  "maxRounds": 6,
  "maxMinutes": 180,
  "turnMinutes": 45,
  "branchPrefix": "agent",
  "worktreeRoot": ".propscout-agent-worktrees",
  "runtimeRoot": ".propscout-agent-runtime",
  "protectedPaths": [
    ".agent-loop/",
    "scripts/agent-loop/",
    "docs/agent-loop/prompts/",
    "docs/agent-loop/schemas/",
    ".github/workflows/",
    "AGENTS.md",
    "CLAUDE.md",
    "package.json",
    "package-lock.json",
    "apps/web/package.json",
    "apps/api/package.json",
    ".lintstagedrc.cjs",
    ".husky/",
    "services/calc-engine/conftest.py",
    "services/scrapers/conftest.py",
    "services/calc-engine/requirements.txt",
    "services/scrapers/requirements.txt"
  ],
  "humanGatePaths": [
    ".env",
    ".env.",
    "supabase/migrations/",
    "railway.json",
    "vercel.json",
    "services/scrapers/railway.json"
  ],
  "forbiddenPathFragments": [
    "node_modules/",
    ".git/",
    ".vercel/",
    "dist/",
    "__pycache__/",
    ".venv/"
  ],
  "bootstrap": {
    "steps": [
      {
        "name": "npm ci",
        "command": "npm",
        "args": ["ci", "--no-audit", "--no-fund"],
        "timeoutMs": 900000
      },
      {
        "name": "python venv",
        "command": "py",
        "args": ["-3.11", "-m", "venv", "--clear", ".venv"],
        "timeoutMs": 300000
      },
      {
        "name": "pip calc-engine",
        "command": "python",
        "args": ["-m", "pip", "install", "--quiet", "-r", "services/calc-engine/requirements.txt"],
        "timeoutMs": 900000
      },
      {
        "name": "pip scrapers",
        "command": "python",
        "args": ["-m", "pip", "install", "--quiet", "-r", "services/scrapers/requirements.txt"],
        "timeoutMs": 900000
      },
      {
        "name": "pip lint tools",
        "command": "python",
        "args": ["-m", "pip", "install", "--quiet", "black", "flake8"],
        "timeoutMs": 300000
      }
    ]
  },
  "gates": [
    {
      "name": "web typecheck",
      "command": "npm",
      "args": ["run", "typecheck", "--workspace=apps/web"]
    },
    {
      "name": "api typecheck",
      "command": "npm",
      "args": ["run", "typecheck", "--workspace=apps/api"]
    },
    { "name": "web lint", "command": "npm", "args": ["run", "lint", "--workspace=apps/web"] },
    { "name": "api lint", "command": "npm", "args": ["run", "lint", "--workspace=apps/api"] },
    {
      "name": "python format",
      "command": "python",
      "args": [
        "-m",
        "black",
        "--check",
        "--quiet",
        "services/calc-engine",
        "services/scrapers",
        "scripts"
      ]
    },
    {
      "name": "python lint",
      "command": "python",
      "args": ["-m", "flake8", "services/calc-engine", "services/scrapers", "scripts"]
    },
    { "name": "web tests", "command": "npm", "args": ["test", "--workspace=apps/web"] },
    { "name": "api tests", "command": "npm", "args": ["test", "--workspace=apps/api"] },
    {
      "name": "calc engine",
      "command": "python",
      "args": ["-m", "pytest", "services/calc-engine/", "-q"]
    },
    {
      "name": "scrapers",
      "command": "python",
      "args": ["-m", "pytest", "services/scrapers/", "-q"]
    }
  ]
}
